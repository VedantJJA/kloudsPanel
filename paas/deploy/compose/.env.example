# kloudsPanel environment template
# Copy to .env and fill in values before starting the platform.

# --- Required ----------------------------------------------------------------

# Your root domain (e.g. example.com). Control plane served at https://<ROOT_DOMAIN>.
# All deployed services will be accessible as subdomains of this domain.
ROOT_DOMAIN=

# Email address for ACME / Let's Encrypt certificate issuance.
ACME_EMAIL=

# AES-256 master key for encrypting secrets at rest.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY_HEX=changeme_generate_32_bytes_hex_64_chars

# --- Optional -----------------------------------------------------------------

# Initial admin password for first boot. If not set, a random password
# will be auto-generated and printed to the API server logs on first start.
# ADMIN_PASSWORD=

# Admin email for the bootstrap admin account (default: admin@klouds.local)
# ADMIN_EMAIL=admin@klouds.local

# Database backend: sqlite (default) or postgres
DB_DRIVER=sqlite
DB_PATH=/data/klouds.db

# PostgreSQL DSN (only when DB_DRIVER=postgres)
# DATABASE_URL=postgres://klouds:password@localhost:5432/klouds?sslmode=require

# API server listen address
LISTEN_ADDR=:8080

# Docker socket path
DOCKER_HOST=unix:///var/run/docker.sock

# Agent Unix socket path
AGENT_SOCKET=/run/klouds/agent.sock

# --- Git OAuth Integrations (Optional) ----------------------------------------
# Enables 1-click OAuth authorization for users connecting their Git accounts.

# GitHub OAuth Callback: https://<ROOT_DOMAIN>/api/v1/integrations/git/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitLab OAuth Callback: https://<ROOT_DOMAIN>/api/v1/integrations/git/gitlab/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Bitbucket OAuth Callback: https://<ROOT_DOMAIN>/api/v1/integrations/git/bitbucket/callback
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
